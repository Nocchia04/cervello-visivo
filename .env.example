# ============================================================
# Cervello Visivo — Environment Variables
# Copia questo file in .env con: npm run setup
# Il JWT_SECRET verrà generato automaticamente.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL (Docker)
# Queste credenziali devono corrispondere a docker-compose.yml
# ------------------------------------------------------------
POSTGRES_USER=cervello
POSTGRES_PASSWORD=cervello_secret
POSTGRES_DB=cervello_visivo

# URL usato da Prisma (punta al container Docker sulla porta 5432)
DATABASE_URL="postgresql://cervello:cervello_secret@localhost:5432/cervello_visivo?schema=public"

# ------------------------------------------------------------
# Auth — JWT
# Generato automaticamente da scripts/setup.sh (openssl rand -base64 32)
# NON usare il valore di esempio in produzione.
# ------------------------------------------------------------
JWT_SECRET="PLACEHOLDER_GENERATO_DA_SETUP_SH"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------
# Server (apps/server)
# ------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------
# Web App (apps/web) — variabili pubbliche Next.js
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/graphql"
NEXT_PUBLIC_UPLOAD_URL="http://localhost:4000/upload"

# ------------------------------------------------------------
# pgAdmin (solo Docker, non usato dall'app)
# Accessibile su http://localhost:5050
# ------------------------------------------------------------
PGADMIN_EMAIL=admin@cervello.local
PGADMIN_PASSWORD=admin
