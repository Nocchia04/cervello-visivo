generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  CAPO_CANTIERE
}

enum StatoCantiere {
  ATTIVO
  ARCHIVIATO
}

// ─── Models ──────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  cognome   String
  role      UserRole @default(CAPO_CANTIERE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foto360       Foto360[]
  annotazioni   Annotazione[]
  cantieri      CantiereUser[]
  inviti        Invito[]            @relation("InvitiCreati")
  linkCondivisione LinkCondivisione[] @relation("LinkCondivisioneCreatore")

  @@map("users")
}

model Cantiere {
  id        String          @id @default(cuid())
  nome      String
  indirizzo String
  stato        StatoCantiere   @default(ATTIVO)
  thumbnailUrl String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  piantine          Piantina[]
  utenti            CantiereUser[]
  linkCondivisione  LinkCondivisione[]

  @@map("cantieri")
}

model CantiereUser {
  id         String   @id @default(cuid())
  cantiereId String
  userId     String
  createdAt  DateTime @default(now())

  cantiere Cantiere @relation(fields: [cantiereId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cantiereId, userId])
  @@map("cantiere_users")
}

model Piantina {
  id         String   @id @default(cuid())
  cantiereId String
  nome       String
  livello    Int
  fileUrl    String
  larghezza  Int
  altezza    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cantiere      Cantiere        @relation(fields: [cantiereId], references: [id], onDelete: Cascade)
  puntiDiScatto PuntoDiScatto[]

  @@map("piantine")
}

model PuntoDiScatto {
  id         String   @id @default(cuid())
  piantinaId String
  nome       String
  x          Float
  y          Float
  dimensione String   @default("MEDIO") // PICCOLO | MEDIO | GRANDE | XL — dimensione del marker
  createdAt  DateTime @default(now())

  piantina Piantina  @relation(fields: [piantinaId], references: [id], onDelete: Cascade)
  foto360  Foto360[]

  @@map("punti_di_scatto")
}

model Foto360 {
  id               String   @id @default(cuid())
  puntoDiScattoId  String
  url              String
  thumbnailUrl     String?
  is360            Boolean  @default(true)
  timestamp        DateTime @default(now())
  metadata         Json?
  uploadedById     String?
  createdAt        DateTime @default(now())

  puntoDiScatto PuntoDiScatto @relation(fields: [puntoDiScattoId], references: [id], onDelete: Cascade)
  uploadedBy    User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  annotazioni   Annotazione[]

  @@map("foto_360")
}

model Annotazione {
  id        String   @id @default(cuid())
  foto360Id String
  testo     String
  x         Float
  y         Float
  autoreId  String?
  createdAt DateTime @default(now())

  foto360 Foto360 @relation(fields: [foto360Id], references: [id], onDelete: Cascade)
  autore  User?   @relation(fields: [autoreId], references: [id], onDelete: SetNull)

  @@map("annotazioni")
}

model Invito {
  id          String    @id @default(cuid())
  email       String    @unique
  token       String    @unique @default(cuid())
  role        UserRole  @default(CAPO_CANTIERE)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  createdById String

  createdBy User @relation("InvitiCreati", fields: [createdById], references: [id])

  @@map("inviti")
}

// Link pubblico in sola lettura per condividere un cantiere all'esterno.
// Ogni link ha un token univoco; lo stesso cantiere può avere più link attivi
// (es. uno per cliente, uno per geometra). Revocabile e con scadenza opzionale.
model LinkCondivisione {
  id           String    @id @default(cuid())
  token        String    @unique @default(cuid())
  cantiereId   String
  creatoDaId   String
  expiresAt    DateTime?
  revocato     Boolean   @default(false)
  accessiCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cantiere Cantiere @relation(fields: [cantiereId], references: [id], onDelete: Cascade)
  creatoDa User     @relation("LinkCondivisioneCreatore", fields: [creatoDaId], references: [id], onDelete: Cascade)

  @@index([cantiereId])
  @@index([token])
  @@map("link_condivisione")
}
